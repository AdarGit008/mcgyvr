{
  "$defs": {
    "Ack": {
      "properties": {
        "body": {
          "$ref": "#/$defs/AckBody",
          "default": {
            "heartbeat_interval_s": null,
            "rig_id": null
          }
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "re": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Re",
          "type": "string"
        },
        "type": {
          "const": "ack",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "maximum": 1,
          "minimum": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "id",
        "re",
        "type"
      ],
      "title": "Ack",
      "type": "object"
    },
    "AckBody": {
      "properties": {
        "heartbeat_interval_s": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heartbeat Interval S"
        },
        "rig_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rig Id"
        }
      },
      "title": "AckBody",
      "type": "object"
    },
    "AgentMessage": {
      "description": "A message an agent sends.",
      "discriminator": {
        "mapping": {
          "ack": "#/$defs/Ack",
          "error": "#/$defs/Error",
          "heartbeat": "#/$defs/Heartbeat",
          "hello": "#/$defs/Hello"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/Heartbeat"
        },
        {
          "$ref": "#/$defs/Ack"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ]
    },
    "CardReading": {
      "properties": {
        "index": {
          "exclusiveMaximum": 64,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "vram_free_mb": {
          "maximum": 1073741824,
          "minimum": 0,
          "title": "Vram Free Mb",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "vram_free_mb"
      ],
      "title": "CardReading",
      "type": "object"
    },
    "CardReport": {
      "properties": {
        "index": {
          "exclusiveMaximum": 64,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u202a-\\u202e\\u2066-\\u2069]+$",
          "title": "Name",
          "type": "string"
        },
        "vram_free_mb": {
          "maximum": 1073741824,
          "minimum": 0,
          "title": "Vram Free Mb",
          "type": "integer"
        },
        "vram_total_mb": {
          "maximum": 1073741824,
          "minimum": 0,
          "title": "Vram Total Mb",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "name",
        "vram_total_mb",
        "vram_free_mb"
      ],
      "title": "CardReport",
      "type": "object"
    },
    "Envelope": {
      "description": "What every message looks like, including types added after v1.",
      "properties": {
        "body": {
          "additionalProperties": true,
          "default": {},
          "title": "Body",
          "type": "object"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "re": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Re"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "maximum": 1,
          "minimum": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "type",
        "id"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "Error": {
      "properties": {
        "body": {
          "$ref": "#/$defs/ErrorBody"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "re": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Re"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "maximum": 1,
          "minimum": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "id",
        "type",
        "body"
      ],
      "title": "Error",
      "type": "object"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "Heartbeat": {
      "properties": {
        "body": {
          "$ref": "#/$defs/HeartbeatBody",
          "default": {
            "cards": [],
            "ram_free_mb": null
          }
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "re": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Re"
        },
        "type": {
          "const": "heartbeat",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "maximum": 1,
          "minimum": 1,
          "title": "V",
          "type": "integer"
        }
